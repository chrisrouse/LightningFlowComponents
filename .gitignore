# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore
.vscode/
.idea/
/IlluminatedCloud/
.prettier*

**mdapi
# Salesforce cache
.sfdx/
.sf/

force-app/main/default/profiles

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.iml

# Other files
.npmignore
.gitignore
package-lock.json
jsconfig.json
.lwc/jsconfig.json
# Generated per-LWC-folder TypeScript config, same category as jsconfig.json above.
# The Salesforce VS Code extension writes one into every lwc/ directory in the repo
# — ~150 of them — which otherwise buries any real diff.
tsconfig.json
.sf/config.json
.pmdCache

# --- Flow Grid fork: toolchain files that must be tracked ---
# Upstream ignores these; this fork ships a real LWC test/lint toolchain, so the
# Prettier config and the lockfile need to be committed for reproducible installs
# and consistent formatting (the vendored kit is pinned pre-1.0).
!.prettierrc
!.prettierignore
!package-lock.json
